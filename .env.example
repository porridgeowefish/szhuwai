# ====================================
# 户外活动规划助手 - 环境变量配置模板
# ====================================
# 使用方法：
# 1. 复制为 .env: cp .env.example .env
# 2. 填写下面的 API 密钥
# 3. 本地开发: make dev-backend （后端启动时自动读取同目录 .env）

# 和风天气 API Key  https://dev.qweather.com/
QWEATHER_API_KEY=
# 和风开发者 host（控制台「开发者 ID」分配；标准版填 devapi）
WEATHER_DEVELOPER_HOST=devapi

# 高德地图【Web 服务】API Key  https://console.amap.com/
# 注意：是「Web 服务」类型的 key，不是浏览器 JS API key；前后不要带空格
AMAP_API_KEY=

# 搜索服务  https://www.tavily.com/
# SEARCH_PROVIDER: tavily（默认，有免费额度）/ jina（需 jina_ key + 代理）https://jina.ai/
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
# 未设置 SEARCH_API_KEY 时回退读取 TAVILY_API_KEY
# TAVILY_API_KEY=

# 大模型 API Key（当前极速策划不调用 LLM；保留给后续 AI 增强用）https://cloud.siliconflow.cn/
LLM_API_KEY=
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=Pro/moonshotai/Kimi-K2.5

# 代理（可选）——选用 jina 搜索或访问海外服务时需要
# PROXY_HTTP=http://127.0.0.1:7890
# PROXY_HTTPS=http://127.0.0.1:7890
